{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quicktimer",
  "version": "0.1.0",
  "identifier": "com.quicktimer.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quicktimer",
        "width": 1200,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Focus timer",
    "longDescription": "A focus timer with task dashboard."
  }
}
